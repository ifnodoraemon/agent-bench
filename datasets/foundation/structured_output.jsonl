{"id": "struct_001", "category": "structured_output", "tags": ["structured_output", "schema"], "prompt": "Extract user profile from: 'Dr. Jane Smith, 34 years old, Senior AI Researcher at DeepMind, email: jane.smith@deepmind.com'. Output a valid JSON adhering to the specified schema without code blocks.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"name": {"type": "string"}, "age": {"type": "integer"}, "role": {"type": "string"}, "company": {"type": "string"}, "email": {"type": "string"}}, "required": ["name", "age", "role", "company", "email"]}}
{"id": "struct_002", "category": "structured_output", "tags": ["structured_output", "order"], "prompt": "Parse this order: 'Order #ORD-9821 placed on 2026-08-20, total amount $249.99, contains 3 items: 2x Keyboard, 1x Mouse. Status: PAID.' Output valid JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"order_id": {"type": "string"}, "date": {"type": "string"}, "total_amount": {"type": "number"}, "item_count": {"type": "integer"}, "status": {"type": "string", "enum": ["PAID", "PENDING", "CANCELLED"]}}, "required": ["order_id", "date", "total_amount", "item_count", "status"]}}
{"id": "struct_003", "category": "structured_output", "tags": ["structured_output", "nested_geo"], "prompt": "Extract server location: 'Server US-WEST-2 located in Oregon, USA (lat: 45.52, lon: -122.67), active status true'. Output valid JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"server_id": {"type": "string"}, "country": {"type": "string"}, "coordinates": {"type": "object", "properties": {"lat": {"type": "number"}, "lon": {"type": "number"}}, "required": ["lat", "lon"]}, "active": {"type": "boolean"}}, "required": ["server_id", "country", "coordinates", "active"]}}
{"id": "struct_004", "category": "structured_output", "tags": ["structured_output", "metrics"], "prompt": "Summarize system performance: 'CPU load 78.5%, Memory used 14.2 GB of 32.0 GB, Disk usage 65%, 0 errors detected'. Output valid JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"cpu_load_percent": {"type": "number"}, "memory_used_gb": {"type": "number"}, "memory_total_gb": {"type": "number"}, "disk_usage_percent": {"type": "integer"}, "errors_count": {"type": "integer"}}, "required": ["cpu_load_percent", "memory_used_gb", "memory_total_gb", "disk_usage_percent", "errors_count"]}}
{"id": "struct_005", "category": "structured_output", "tags": ["structured_output", "product"], "prompt": "Extract product details: 'Product: NVIDIA H100 GPU, manufacturer: NVIDIA, release_year: 2022, architecture: Hopper, memory_capacity_gb: 80'. Output valid JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"product_name": {"type": "string"}, "manufacturer": {"type": "string"}, "release_year": {"type": "integer"}, "architecture": {"type": "string"}, "memory_capacity_gb": {"type": "integer"}}, "required": ["product_name", "manufacturer", "release_year", "architecture", "memory_capacity_gb"]}}
{"id": "struct_006", "category": "structured_output", "tags": ["structured_output", "invoice"], "prompt": "Extract invoice details: 'Invoice INV-2026-004 issued to Acme Corp, subtotal $1200.00, tax $120.00, total $1320.00, currency USD, items: [{\"desc\":\"Cloud Hosting\",\"amount\":1000.0},{\"desc\":\"Support Fee\",\"amount\":200.0}]'. Output valid JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"invoice_number": {"type": "string"}, "customer": {"type": "string"}, "subtotal": {"type": "number"}, "tax": {"type": "number"}, "total": {"type": "number"}, "currency": {"type": "string", "enum": ["USD", "EUR", "GBP", "CNY"]}, "items": {"type": "array", "items": {"type": "object", "properties": {"desc": {"type": "string"}, "amount": {"type": "number"}}, "required": ["desc", "amount"]}}}, "required": ["invoice_number", "customer", "total", "currency", "items"]}}
{"id": "struct_007", "category": "structured_output", "tags": ["structured_output", "resume"], "prompt": "Extract candidate info: 'Alex Chen, 8 years of experience, current role Lead Backend Engineer, skills: [\"Rust\", \"Python\", \"Distributed Systems\"], degree Master of Science, university Stanford University'. Output valid JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"candidate_name": {"type": "string"}, "years_experience": {"type": "integer"}, "current_title": {"type": "string"}, "skills": {"type": "array", "items": {"type": "string"}}, "degree": {"type": "string"}, "university": {"type": "string"}}, "required": ["candidate_name", "years_experience", "current_title", "skills", "degree", "university"]}}
{"id": "struct_008", "category": "structured_output", "tags": ["structured_output", "flight"], "prompt": "Parse flight itinerary: 'Flight UA889 departing SFO to HND on 2026-09-15 at 11:30, seat 14B, cabin_class Business, is_direct true'. Output valid JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"flight_number": {"type": "string"}, "origin": {"type": "string"}, "destination": {"type": "string"}, "date": {"type": "string"}, "seat": {"type": "string"}, "cabin_class": {"type": "string", "enum": ["Economy", "Premium Economy", "Business", "First"]}, "is_direct": {"type": "boolean"}}, "required": ["flight_number", "origin", "destination", "date", "cabin_class", "is_direct"]}}
{"id": "struct_009", "category": "structured_output", "tags": ["structured_output", "prescription"], "prompt": "Extract prescription: 'Patient: Robert Taylor, Drug: Amoxicillin, dosage_mg: 500, frequency_per_day: 3, duration_days: 10, take_with_food: true'. Output valid JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"patient_name": {"type": "string"}, "medication": {"type": "string"}, "dosage_mg": {"type": "integer"}, "frequency_per_day": {"type": "integer"}, "duration_days": {"type": "integer"}, "take_with_food": {"type": "boolean"}}, "required": ["patient_name", "medication", "dosage_mg", "frequency_per_day", "duration_days", "take_with_food"]}}
{"id": "struct_010", "category": "structured_output", "tags": ["structured_output", "github_pr"], "prompt": "Extract PR data: 'PR #142 titled \"fix: memory leak in connection pool\" by octocat, base_branch main, head_branch fix/leak, changed_files_count 4, is_draft false'. Output valid JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"pr_number": {"type": "integer"}, "title": {"type": "string"}, "author": {"type": "string"}, "base_branch": {"type": "string"}, "head_branch": {"type": "string"}, "changed_files_count": {"type": "integer"}, "is_draft": {"type": "boolean"}}, "required": ["pr_number", "title", "author", "base_branch", "head_branch", "changed_files_count", "is_draft"]}}
{"id": "struct_011", "category": "structured_output", "tags": ["structured_output", "iot_thermostat"], "prompt": "Parse thermostat status: 'Device TH-901, current_temperature_celsius 21.5, target_temperature_celsius 22.0, mode HEAT, fan_speed 2, humidity_percent 45'. Output valid JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"device_id": {"type": "string"}, "current_temperature_celsius": {"type": "number"}, "target_temperature_celsius": {"type": "number"}, "mode": {"type": "string", "enum": ["HEAT", "COOL", "FAN", "OFF"]}, "fan_speed": {"type": "integer"}, "humidity_percent": {"type": "integer"}}, "required": ["device_id", "current_temperature_celsius", "target_temperature_celsius", "mode", "fan_speed", "humidity_percent"]}}
{"id": "struct_012", "category": "structured_output", "tags": ["structured_output", "db_schema"], "prompt": "Convert DDL info: 'Table customers columns: id (data_type INTEGER, is_primary_key true), name (data_type VARCHAR, is_primary_key false), email (data_type VARCHAR, is_primary_key false)'. Output valid JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"table_name": {"type": "string"}, "columns": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "data_type": {"type": "string"}, "is_primary_key": {"type": "boolean"}}, "required": ["name", "data_type", "is_primary_key"]}}}, "required": ["table_name", "columns"]}}
{"id": "struct_013", "category": "structured_output", "tags": ["structured_output", "weather"], "prompt": "Format weather report: 'City: Tokyo, condition: Rain, temperature_celsius: 18.0, wind_speed_kph: 15.2, precipitation_chance_percent: 80'. Output valid JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"city": {"type": "string"}, "condition": {"type": "string"}, "temperature_celsius": {"type": "number"}, "wind_speed_kph": {"type": "number"}, "precipitation_chance_percent": {"type": "integer"}}, "required": ["city", "condition", "temperature_celsius", "wind_speed_kph", "precipitation_chance_percent"]}}
{"id": "struct_014", "category": "structured_output", "tags": ["structured_output", "review"], "prompt": "Extract product review: 'Review ID: REV-8821, rating: 5, verified_purchase: true, title: \"Outstanding build quality\", sentiment: POSITIVE, pros: [\"fast\", \"durable\"], cons: [\"pricey\"]'. Output valid JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"review_id": {"type": "string"}, "rating": {"type": "integer", "minimum": 1, "maximum": 5}, "verified_purchase": {"type": "boolean"}, "title": {"type": "string"}, "sentiment": {"type": "string", "enum": ["POSITIVE", "NEUTRAL", "NEGATIVE"]}, "pros": {"type": "array", "items": {"type": "string"}}, "cons": {"type": "array", "items": {"type": "string"}}}, "required": ["review_id", "rating", "verified_purchase", "title", "sentiment", "pros", "cons"]}}
{"id": "struct_015", "category": "structured_output", "tags": ["structured_output", "k8s_pod"], "prompt": "Extract Kubernetes pod descriptor: 'Pod name: redis-cache, namespace: production, container_name: redis, image: redis:7.2-alpine, container_port: 6379, restart_policy: Always'. Output valid JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"pod_name": {"type": "string"}, "namespace": {"type": "string"}, "container_name": {"type": "string"}, "image": {"type": "string"}, "container_port": {"type": "integer"}, "restart_policy": {"type": "string", "enum": ["Always", "OnFailure", "Never"]}}, "required": ["pod_name", "namespace", "container_name", "image", "container_port", "restart_policy"]}}
{"id": "struct_016", "category": "structured_output", "tags": ["structured_output", "schema"], "prompt": "Generate a JSON object representing an HTTP Response with `status_code` (int, 200), `status_text` (\"OK\"), `headers` (object with `content-type`: `application/json`), and `body` (object with `success`: true). Output raw JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"status_code": {"type": "integer", "enum": [200]}, "status_text": {"type": "string", "enum": ["OK"]}, "headers": {"type": "object"}, "body": {"type": "object"}}, "required": ["status_code", "status_text", "headers", "body"]}}
{"id": "struct_017", "category": "structured_output", "tags": ["structured_output", "geo"], "prompt": "Generate a GeoJSON Point object for Tokyo (latitude 35.6762, longitude 139.6503). Output strictly JSON with type='Point' and coordinates=[139.6503, 35.6762].", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"type": {"type": "string", "enum": ["Point"]}, "coordinates": {"type": "array", "minItems": 2, "maxItems": 2}}, "required": ["type", "coordinates"]}}
{"id": "struct_018", "category": "structured_output", "tags": ["structured_output", "user_profile"], "prompt": "Output a JSON object for a user profile with `id` (int), `username` (string), `email` (string), `is_active` (boolean), and `roles` (array of strings). Output only valid JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"id": {"type": "integer"}, "username": {"type": "string"}, "email": {"type": "string"}, "is_active": {"type": "boolean"}, "roles": {"type": "array", "items": {"type": "string"}}}, "required": ["id", "username", "email", "is_active", "roles"]}}
{"id": "struct_019", "category": "structured_output", "tags": ["structured_output", "ecommerce"], "prompt": "Create an invoice JSON object containing `invoice_id` (string), `items` (array of objects with `name`, `quantity`, `price`), and `total` (number). Output only JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"invoice_id": {"type": "string"}, "items": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "quantity": {"type": "integer"}, "price": {"type": "number"}}, "required": ["name", "quantity", "price"]}}, "total": {"type": "number"}}, "required": ["invoice_id", "items", "total"]}}
{"id": "struct_020", "category": "structured_output", "tags": ["structured_output", "database"], "prompt": "Generate a database migration configuration in JSON with `table_name` (string), `columns` (array of objects with `name`, `type`, `nullable`), and `primary_key` (string). Output only JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"table_name": {"type": "string"}, "columns": {"type": "array"}, "primary_key": {"type": "string"}}, "required": ["table_name", "columns", "primary_key"]}}
{"id": "struct_021", "category": "structured_output", "tags": ["structured_output", "pagination"], "prompt": "Generate a paginated API response JSON with `page` (int 1), `per_page` (int 20), `total_items` (int 100), `total_pages` (int 5), and `data` (array). Output only JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"page": {"type": "integer", "enum": [1]}, "per_page": {"type": "integer", "enum": [20]}, "total_items": {"type": "integer", "enum": [100]}, "total_pages": {"type": "integer", "enum": [5]}, "data": {"type": "array"}}, "required": ["page", "per_page", "total_items", "total_pages", "data"]}}
{"id": "struct_022", "category": "structured_output", "tags": ["structured_output", "healthcheck"], "prompt": "Generate a system healthcheck status in JSON with `status` (\"UP\" | \"DOWN\"), `checks` (array of objects with `name` and `status`), and `timestamp` (string). Output only JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"status": {"type": "string", "enum": ["UP", "DOWN", "healthy", "ok"]}, "checks": {"type": "array"}, "timestamp": {"type": "string"}}, "required": ["status", "checks", "timestamp"]}}
{"id": "struct_023", "category": "structured_output", "tags": ["structured_output", "weather"], "prompt": "Provide weather report JSON for 'Paris' with `city` (string), `temperature_celsius` (number), `humidity_percent` (int), and `condition` (string). Output only JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"city": {"type": "string"}, "temperature_celsius": {"type": "number"}, "humidity_percent": {"type": "integer"}, "condition": {"type": "string"}}, "required": ["city", "temperature_celsius", "humidity_percent", "condition"]}}
{"id": "struct_024", "category": "structured_output", "tags": ["structured_output", "auth"], "prompt": "Generate a JWT authentication payload in JSON with `sub` (string user ID), `iat` (integer timestamp), `exp` (integer timestamp), and `role` (string \"admin\"). Output only JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"sub": {"type": "string"}, "iat": {"type": "integer"}, "exp": {"type": "integer"}, "role": {"type": "string"}}, "required": ["sub", "iat", "exp", "role"]}}
{"id": "struct_025", "category": "structured_output", "tags": ["structured_output", "metrics"], "prompt": "Format server performance metrics in JSON with `cpu_usage_percent` (float), `memory_used_mb` (int), `memory_total_mb` (int), and `load_average` (array of 3 floats). Output only JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"cpu_usage_percent": {"type": "number"}, "memory_used_mb": {"type": "integer"}, "memory_total_mb": {"type": "integer"}, "load_average": {"type": "array", "minItems": 3, "maxItems": 3}}, "required": ["cpu_usage_percent", "memory_used_mb", "memory_total_mb", "load_average"]}}
{"id": "struct_026", "category": "structured_output", "tags": ["structured_output", "error_payload"], "prompt": "Format a standard RFC 7807 problem details error payload in JSON with `type` (URI string), `title` (string), `status` (int 404), and `detail` (string). Output only JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"type": {"type": "string"}, "title": {"type": "string"}, "status": {"type": "integer", "enum": [404]}, "detail": {"type": "string"}}, "required": ["type", "title", "status", "detail"]}}
{"id": "struct_027", "category": "structured_output", "tags": ["structured_output", "semver"], "prompt": "Extract semantic version components of \"2.14.3-beta.1\" into JSON with `major` (int 2), `minor` (int 14), `patch` (int 3), and `prerelease` (string \"beta.1\"). Output only JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"major": {"type": "integer", "enum": [2]}, "minor": {"type": "integer", "enum": [14]}, "patch": {"type": "integer", "enum": [3]}, "prerelease": {"type": "string", "enum": ["beta.1"]}}, "required": ["major", "minor", "patch", "prerelease"]}}
{"id": "struct_028", "category": "structured_output", "tags": ["structured_output", "docker"], "prompt": "Create a docker-compose service entry in JSON format for an nginx container with `image` (\"nginx:alpine\"), `ports` (array with \"80:80\"), and `restart` (\"always\"). Output only JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"image": {"type": "string"}, "ports": {"type": "array"}, "restart": {"type": "string"}}, "required": ["image", "ports", "restart"]}}
{"id": "struct_029", "category": "structured_output", "tags": ["structured_output", "log_entry"], "prompt": "Generate a structured JSON log entry with `level` (\"INFO\"|\"WARN\"|\"ERROR\"), `message` (string), `service` (string), `trace_id` (string), and `timestamp` (string). Output only JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"level": {"type": "string"}, "message": {"type": "string"}, "service": {"type": "string"}, "trace_id": {"type": "string"}, "timestamp": {"type": "string"}}, "required": ["level", "message", "service", "trace_id", "timestamp"]}}
{"id": "struct_030", "category": "structured_output", "tags": ["structured_output", "shopping_cart"], "prompt": "Generate a shopping cart summary in JSON with `cart_id` (string), `item_count` (int), `subtotal_usd` (number), `tax_usd` (number), and `grand_total_usd` (number). Output only JSON.", "eval_type": "json_schema", "schema": {"type": "object", "properties": {"cart_id": {"type": "string"}, "item_count": {"type": "integer"}, "subtotal_usd": {"type": "number"}, "tax_usd": {"type": "number"}, "grand_total_usd": {"type": "number"}}, "required": ["cart_id", "item_count", "subtotal_usd", "tax_usd", "grand_total_usd"]}}
